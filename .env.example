# Copy to .env and fill in. Never commit .env.
SAFEGATE_UPSTREAM_BASE_URL=https://api.openai.com/v1
SAFEGATE_UPSTREAM_API_KEY=sk-...
SAFEGATE_DATABASE_URL=postgresql+asyncpg://safegate:safegate@db:5432/safegate
SAFEGATE_POLICY_DIR=policies
# Guarded RAG (/v1/rag/*). Empty base URL and key fall back to the upstream ones. For Gemini:
# SAFEGATE_RAG_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SAFEGATE_RAG_API_KEY=...
# SAFEGATE_RAG_CHAT_MODEL=gemini-flash-latest
# SAFEGATE_RAG_EMBED_MODEL=gemini-embedding-001
