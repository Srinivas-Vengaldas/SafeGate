# Public demo image: the gateway image plus the trained classifier, tuned for a 512 MB host.
# Built by .github/workflows/deploy-demo.yml from a directory holding the exported ONNX model
# (model/) and the demo policy (policy.yaml).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY --chown=safegate model /srv/models/injection-onnx
COPY --chown=safegate policy.yaml /srv/policies/default.yaml

# Tokenizer-only spaCy pipeline: pattern-based PII detection still works and it saves ~80 MB.
ENV SAFEGATE_SPACY_MODEL=blank
# Render's proxy sets X-Forwarded-For, so the rate limit can count visitors individually.
ENV SAFEGATE_TRUST_FORWARDED_FOR=true
